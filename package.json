{
  "name": "kmd-web-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Canonical JavaScript rendering engine for the kmd ecosystem.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:clean": "tsc --build --clean && npm run build",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "verify": "npm run check:versions && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:versions": "node scripts/check-versions.mjs",
    "check:contents": "node scripts/check-package-contents.mjs",
    "check:api": "node scripts/check-api-surface.mjs",
    "check:size": "node scripts/size-report.mjs",
    "check:release": "node scripts/dry-run-release.mjs",
    "check:publish": "node scripts/publish-packages.mjs --dry-run",
    "check:examples": "node scripts/refresh-examples.mjs --check",
    "refresh:examples": "node scripts/refresh-examples.mjs",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "build:visual": "npx tsx tests/visual/prerender.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.62.1",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.1",
    "axe-core": "^4.12.1",
    "happy-dom": "^20.11.1",
    "katex": "^0.16.47",
    "mermaid": "^11.14.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "shiki": "^4.0.2",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
