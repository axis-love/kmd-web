{
  "name": "@axis-love/styles",
  "version": "0.1.0-rc.0",
  "description": "Scoped reader CSS and generated design tokens for kmd-web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axis-love/kmd-web.git",
    "directory": "packages/styles"
  },
  "bugs": {
    "url": "https://github.com/axis-love/kmd-web/issues"
  },
  "homepage": "https://github.com/axis-love/kmd-web/tree/main/packages/styles#readme",
  "type": "module",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./generated/tokens.css": "./generated/tokens.css",
    "./generated/unity-tokens.json": "./generated/unity-tokens.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "src/styles.css",
    "src/tokens.css",
    "generated/tokens.css",
    "generated/unity-tokens.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
