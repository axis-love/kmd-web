{
  "name": "@axis-love/kmd-web",
  "version": "0.1.0",
  "description": "Convenience exports for the supported public kmd-web entry points.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./styles.css": "@axis-love/styles/styles.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@axis-love/contracts": "*",
    "@axis-love/core": "*",
    "@axis-love/browser": "*",
    "@axis-love/react": "*",
    "@axis-love/element": "*",
    "@axis-love/styles": "*"
  }
}
