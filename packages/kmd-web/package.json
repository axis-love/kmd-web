{
  "name": "@axis-love/kmd-web",
  "version": "0.1.0-rc.0",
  "description": "Convenience exports for the supported public kmd-web entry points.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axis-love/kmd-web.git",
    "directory": "packages/kmd-web"
  },
  "bugs": {
    "url": "https://github.com/axis-love/kmd-web/issues"
  },
  "homepage": "https://github.com/axis-love/kmd-web/tree/main/packages/kmd-web#readme",
  "type": "module",
  "private": false,
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./styles.css": "./styles.css"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "styles.css"
  ],
  "dependencies": {
    "@axis-love/contracts": "0.1.0-rc.0",
    "@axis-love/core": "0.1.0-rc.0",
    "@axis-love/browser": "0.1.0-rc.0",
    "@axis-love/react": "0.1.0-rc.0",
    "@axis-love/element": "0.1.0-rc.0",
    "@axis-love/styles": "0.1.0-rc.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
