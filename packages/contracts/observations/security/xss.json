{
  "fixture": "security/xss.md",
  "category": "security",
  "description": "XSS attack vectors: javascript: links, vbscript:, data: URIs, file:, event handlers, SVG scripts, encoded URLs, object/embed, script/iframe/form/meta/style tags",
  "html": {
    "mustContain": ["https://example.com"],
    "mustNotContain": [
      "javascript:",
      "vbscript:",
      "data:text/html",
      "file://",
      "<script",
      "<iframe",
      "<object",
      "<embed",
      "<form",
      "<meta",
      "<style",
      "onerror",
      "onclick",
      "onload",
      "alert(",
      "<svg"
    ]
  },
  "diagnostics": {
    "mustIncludeCodes": ["unsafe-url"],
    "minSeverity": "warning"
  },
  "detectedFeatures": {
    "hasMath": false,
    "hasMermaid": false,
    "hasDesignDoc": false,
    "hasCodeHighlighting": false,
    "hasTables": false,
    "hasTaskLists": false,
    "hasFootnotes": false,
    "hasAlerts": false
  },
  "links": {
    "classifications": [
      { "url": "javascript:alert('xss')", "kind": "blocked" },
      { "url": "javascript:void(0)", "kind": "blocked" },
      { "url": "vbscript:MsgBox('xss')", "kind": "blocked" },
      { "url": "data:text/html,%3Cscript%3Ealert(1)%3C/script%3E", "kind": "blocked" },
      { "url": "file:///etc/passwd", "kind": "blocked" },
      { "url": "https://example.com", "kind": "external" }
    ]
  },
  "applicability": "required"
}
