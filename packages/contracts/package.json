{
  "name": "@axis-love/contracts",
  "version": "0.1.0-rc.1",
  "description": "Versioned schemas, fixtures, expected results, feature matrix for the kmd ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axis-love/kmd-web.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/axis-love/kmd-web/issues"
  },
  "homepage": "https://github.com/axis-love/kmd-web/tree/main/packages/contracts#readme",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
