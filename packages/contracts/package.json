    },
    "./manifest.json": "./manifest.json",
    "./fixtures/*": "./fixtures/*",
    "./observations/*": "./observations/*"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "fixtures",
    "observations",
    "manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  }
