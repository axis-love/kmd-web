{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    // Tests exercise the JSDoc-typed release scripts (scripts/*.mjs) directly.
    "allowJs": true,
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "packages", "tests/visual/**"]
}
